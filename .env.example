# =============================================================================
# Beryl Systems HRMS — environment
# =============================================================================
# Copy to .env and fill in. Never commit the real .env.
#
# Filled-in values are the same on every machine. Empty ones differ between
# local and server — set them in each .env. The app reads these with no
# built-in fallbacks: a required key that is missing stops it at boot.
#
# Production Rails does not read this file itself (dotenv is dev/test only);
# hand it to the processes, e.g. systemd `EnvironmentFile=/path/to/.env`.


# =============================================================================
# 1. App — Rails API
# =============================================================================
# `production` on a server.
RAILS_ENV=

# Puma port. 4000 keeps it clear of Next.js on 3000.
PORT=4000

# Puma threads per process; the database pool is sized from the same value.
RAILS_MAX_THREADS=8

# `bin/rails secret`. Required in production.
SECRET_KEY_BASE=

# Public frontend origin(s), comma-separated — drives CORS, CSRF checks, OAuth
# redirects and every link in emails. On a server: the real public address,
# e.g. https://hrms.berylsystems.com.
FRONTEND_ORIGINS=

# HTTPS enforcement (HSTS, Secure cookies). On by default. Set `false` ONLY on
# a server with no certificate (e.g. reached by bare IP) — otherwise browsers
# drop the Secure cookies over plain HTTP and nobody can log in.
# FORCE_SSL=false


# =============================================================================
# 2. Security — Active Record Encryption
# =============================================================================
# Encrypts stored OAuth tokens (Zoho). `bin/rails db:encryption:init`.
# Production refuses to boot without them. Secrets.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=


# =============================================================================
# 3. Database — PostgreSQL
# =============================================================================
DATABASE_HOST=
# Server default is 5432.
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=


# =============================================================================
# 4. Redis — background jobs (Sidekiq), live notifications, caching
# =============================================================================
# e.g. redis://localhost:6379/0
REDIS_URL=


# =============================================================================
# 5. File storage — S3 / R2 (optional)
# =============================================================================
# Leave S3_BUCKET, S3_ACCESS_KEY_ID or S3_SECRET_ACCESS_KEY empty and uploads
# are stored on the server's own disk (backend/storage) instead.
# The endpoint is only used by the backend, never by a browser.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# `true` for Cloudflare R2; empty or `false` for AWS S3.
S3_FORCE_PATH_STYLE=


# =============================================================================
# 6. Email — Resend (password resets, sign-in details, appraisal notifications)
# =============================================================================
# `resend` sends real mail. Empty in development: mail opens in the browser
# instead (letter_opener) and nothing is sent.
MAIL_TRANSPORT=
# Must be on a domain verified at resend.com/domains,
# e.g. "Beryl Systems HRMS <hrms@berylsystems.com>".
MAIL_FROM=
# resend.com/api-keys — "Sending access" is enough. Secret.
RESEND_API_KEY=
# 2587 (STARTTLS). DigitalOcean blocks outbound 25/465/587, so the standard
# 587 times out on the server; 2587 works there and everywhere else.
RESEND_SMTP_PORT=


# =============================================================================
# 7. Zoho Mail — connected mailboxes, resume scanning, recruitment mail
# =============================================================================
# OAuth app from https://api-console.zoho.com.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must match the one registered in Zoho exactly, and be reachable from a
# browser: <public origin>/api/v1/mail/connections/callback
ZOHO_REDIRECT_URI=
# Region-specific: use the .eu / .in / .com.au hosts if the account lives there.
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://mail.zoho.com/api


# =============================================================================
# 8. Calendly — interview scheduling
# =============================================================================
# OAuth app from https://calendly.com/integrations/api_webhooks.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
# Must match the one registered in Calendly exactly:
# <public origin>/api/v1/calendly/connections/callback
CALENDLY_REDIRECT_URI=
# Verifies inbound webhooks — without it every hook is rejected.
CALENDLY_WEBHOOK_SIGNING_KEY=


# =============================================================================
# 9. AI — resume parsing and recruitment insights
# =============================================================================
# anthropic | gemini | deepseek | openai | groq | mistral | together |
# openrouter | fireworks | perplexity | ollama | mock — or any name with AI_BASE_URL.
AI_PROVIDER=
# Key for the provider above. Empty: the app returns mock responses.
AI_API_KEY=
# Optional — each provider has a current default model.
AI_MODEL=
# Only for a provider not built in: its /chat/completions-style base URL.
AI_BASE_URL=


# =============================================================================
# 10. Frontend — Next.js
# =============================================================================
# Baked into the bundle at `npm run build`, not read at runtime.
# Production: leave EMPTY — nginx serves app and API on one origin, so the
# browser calls /api/v1/... on the same host. Never `localhost` on a server.
NEXT_PUBLIC_API_URL=


# =============================================================================
# 11. Seed data — `bin/rails db:seed`
# =============================================================================
# One test company with five logins. Leave SEED_COMPANY_NAME or SEED_PASSWORD
# empty to seed permissions only. Re-running never changes existing users.
SEED_COMPANY_NAME=
# Optional: defaults to the name, lower-cased with dashes.
SEED_COMPANY_SLUG=
# A Rails time zone name, e.g. Kolkata. Defaults to Kolkata.
SEED_COMPANY_TIMEZONE=
# First employee code; the rest count up from it (BS-001, BS-002, …).
SEED_EMPLOYEE_CODE_START=
# Shared password for all five, min 8 characters. Secret.
SEED_PASSWORD=
# One per login; leave any blank to skip that user.
SEED_ADMIN_EMAIL=
SEED_HR_EMAIL=
SEED_ACCOUNTS_EMAIL=
SEED_MANAGER_EMAIL=
SEED_EMPLOYEE_EMAIL=
