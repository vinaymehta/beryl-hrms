# Copy to .env and fill in real values. Never commit the real .env file.

# ---------------------------------------------------------------------------
# Infrastructure (postgres / redis / object storage run as native services)
# ---------------------------------------------------------------------------
POSTGRES_USER=hr_platform
POSTGRES_PASSWORD=hr_platform_dev_password
POSTGRES_DB=hr_platform_development
POSTGRES_PORT=5442

REDIS_PORT=6390

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_BUCKET=hr-platform-storage

# ---------------------------------------------------------------------------
# Backend (Rails API)
# ---------------------------------------------------------------------------
RAILS_ENV=development

# Generate with `bin/rails secret` — required in staging/production, Rails
# falls back to config/master.key in development if unset.
SECRET_KEY_BASE=

# Point at wherever PostgreSQL actually listens. 5442 is the local dev
# convention here; a standard server install listens on 5432.
DATABASE_HOST=localhost
DATABASE_PORT=5442
DATABASE_USER=hr_platform
DATABASE_PASSWORD=hr_platform_dev_password
DATABASE_NAME=hr_platform_development

# Point at wherever Redis actually listens (a standard install uses 6379).
REDIS_URL=redis://localhost:6390/0

# Comma-separated list of allowed frontend origins. Used for CORS, CSRF
# origin checks, the Zoho OAuth redirect back to the app, and password-reset
# email links — so on a server this MUST be the real public origin
# (e.g. http://157.230.85.249). Left at localhost, the browser is blocked by
# CORS/CSRF and OAuth bounces users to a machine that isn't the server.
FRONTEND_ORIGINS=http://localhost:3000

# S3-compatible object storage — MinIO locally, real S3/R2 in staging/prod.
# This is the endpoint the BACKEND uses to reach storage; it is never handed
# to a browser (file bytes are streamed through Rails instead), so an
# internal/loopback address here is fine and preferred.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_dev_password
S3_BUCKET=hr-platform-storage
# S3_FORCE_PATH_STYLE=true is required for MinIO/R2; unset (or false) for AWS S3.
S3_FORCE_PATH_STYLE=true

# SMTP — unused in development (letter_opener intercepts mail there).
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# Calendly — interview scheduling. The candidate books their own slot; Calendly
# owns availability (configure the working-day slots on the event type itself).
# Create an OAuth app at https://calendly.com/integrations/api_webhooks.
# CALENDLY_REDIRECT_URI must exactly match the one registered there.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:3001/api/v1/calendly/connections/callback
# Signing key for inbound webhooks. This is the ONLY authentication on the
# public webhook endpoint — without it every hook is rejected, by design.
CALENDLY_WEBHOOK_SIGNING_KEY=

# Zoho Mail OAuth (Phase 4). No real Zoho API Console app exists yet — these
# are placeholders; the OAuth flow/mail client are fully built and tested
# against mocked Zoho responses (VCR/WebMock), ready to work the moment real
# values are dropped in. Create an app at https://api-console.zoho.com,
# redirect URI must exactly match ZOHO_REDIRECT_URI below. Region-specific:
# use .eu/.in/.com.au etc. base URLs to match where the Zoho account lives.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must match the value registered in the Zoho API Console BYTE FOR BYTE, and
# be reachable from a browser — on a server that is the public origin, e.g.
# http://157.230.85.249/api/v1/mail/connections/callback
ZOHO_REDIRECT_URI=http://localhost:3001/api/v1/mail/connections/callback
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://mail.zoho.com/api

# Active Record Encryption — encrypts ZohoConnection#access_token/#refresh_token
# at rest. Supplied via env rather than Rails credentials because no
# config/master.key is deployed to servers; without these the first mailbox
# request raises, so production boots refuse to start when they're missing.
# Generate with `bin/rails db:encryption:init` and treat as production secrets.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ---------------------------------------------------------------------------
# AI / LLM Configuration (Recruitment Intelligence)
# ---------------------------------------------------------------------------
# Universal: swap agents by changing AI_PROVIDER + a key + AI_MODEL. No code
# changes needed. If the API key for the selected provider is blank, the app
# transparently falls back to fabricated mock responses instead of erroring.
#
# AI_PROVIDER: anthropic | gemini | deepseek | openai | groq | mistral |
# together | openrouter | fireworks | perplexity | ollama (local) | mock
# — or any other name paired with AI_BASE_URL below.
AI_PROVIDER=anthropic

# One key, works for whichever provider is selected above — nothing
# provider-specific to rename when you switch agents.
AI_API_KEY=

# Optional. Each provider has a sensible current default model if left blank
# (e.g. claude-sonnet-4-5 for anthropic, deepseek-chat for deepseek,
# gemini-2.0-flash for gemini).
AI_MODEL=

# Only needed for an AI_PROVIDER not already known (openai, deepseek, groq,
# mistral, together, openrouter, fireworks, perplexity, ollama have their
# OpenAI-compatible endpoint built in). Point this at any other service's
# /chat/completions-style base URL.
AI_BASE_URL=

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* is inlined into the JS bundle at BUILD time — it is NOT read
# when the server process starts, so it must be set before `npm run build`.
# A browser resolves "localhost" against the VISITOR's machine, so this must
# never be localhost in a real deployment.
# When one web server fronts both the app and the API on the same origin,
# leave it EMPTY: requests then go to a relative /api/v1/... path, which is
# always correct and cannot be baked in wrong.
NEXT_PUBLIC_API_URL=http://localhost:3001
