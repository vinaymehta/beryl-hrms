source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.3"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"
# Use Redis adapter to run Action Cable in production
gem "redis", ">= 4.0.1"

# Use Active Model has_secure_password [https://guides.rubyonrails.org/active_model_basics.html#securepassword]
gem "bcrypt", "~> 3.1.7"

# Background jobs
gem "sidekiq"
gem "sidekiq-cron"

# Multi-tenancy, authorization, rate limiting
gem "acts_as_tenant"
gem "pundit"
gem "rack-attack"

# Serialization, pagination
gem "alba"
gem "pagy"

# Structured logging
gem "lograge"

# Object storage (S3-compatible: AWS S3, MinIO, Cloudflare R2)
gem "aws-sdk-s3", require: false

# OpenAPI/Swagger documentation generated from request specs
gem "rswag-api"
gem "rswag-ui"

# ostruct was removed from Ruby's default gems as of Ruby 3.5/4.0 — rswag-ui
# (and possibly other gems) still require it without declaring it themselves.
gem "ostruct"

# Pinned below json 3.0: activesupport 8.1.3.1's ActiveSupport::JSON.decode
# still calls JSON.parse(source, options) positionally, which json 3.0's
# keyword-only signature rejects with ArgumentError — breaks
# generates_token_for's signed-message deserialization (used by email
# verification / password reset), not just app code calling JSON.decode
# directly. A real upstream incompatibility between these two gem versions,
# not a "latest stable" tradeoff — unpin once activesupport catches up.
gem "json", "~> 2.9"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
gem "image_processing", "~> 1.2"

# Use Rack CORS for handling Cross-Origin Resource Sharing (CORS), making cross-origin Ajax possible
gem "rack-cors"

# HTTP client for external APIs (Zoho Mail) — matches the org's established
# pattern (see sibling wi-portal project) for wrapping third-party REST APIs.
gem "faraday"
gem "faraday-retry"

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Audits gems for known security defects (use config/bundler-audit.yml to ignore issues)
  gem "bundler-audit", require: false

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false

  # Load a root-level .env into ENV
  gem "dotenv-rails"

  # Testing
  gem "rspec-rails"
  gem "factory_bot_rails"
  gem "faker"
  gem "rswag-specs"
end

group :test do
  gem "shoulda-matchers"

  # Mocked external API testing (Zoho Mail) — matches the org's established
  # pattern (see sibling wi-portal project); no real Zoho credentials exist
  # yet so this is the actual verification for the OAuth/mail client code.
  gem "vcr"
  gem "webmock"
end

group :development do
  # Opens outgoing email in the browser instead of actually sending it
  gem "letter_opener"
end
